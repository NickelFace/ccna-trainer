{
  "name": "ccna-sync",
  "version": "0.1.0",
  "description": "Cross-device progress sync for CCNA Trainer \u2014 a Cloudflare Worker over D1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-sqlite --test \"test/*.test.js\"",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply ccna-sync --local",
    "migrate:remote": "wrangler d1 migrations apply ccna-sync --remote",
    "deploy": "wrangler deploy",
    "keyhash": "node tools/keyhash.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "wrangler": "4.125.0"
  }
}
